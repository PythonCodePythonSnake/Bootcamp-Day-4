# LangSmith Observability & Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=travel-agent

# Google Gemini API (Required for LLM extraction, planning, and synthesis)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Web Search (Tavily - used by Fallback agent for advisories/events)
TAVILY_API_KEY=your_tavily_api_key

# Flights & Transport (Amadeus API - optional if inter-city flights needed)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# External APIs & Tools (Optional / Free defaults configured in code)
# GOOGLE_MAPS_API_KEY=
# WEATHER_API_KEY=
# CURRENCY_API_KEY=
# TICKETMASTER_API_KEY=